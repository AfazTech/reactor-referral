{
    "name": "afaztech/reactor-referral",
    "description": "Referral tracking with deep-link attribution for Reactor bots.",
    "type": "reactor-package",
    "license": "MIT",
    "keywords": [
        "afaztech",
        "reactor",
        "telegram",
        "telegram-bot",
        "referral",
        "invite",
        "deep-link"
    ],
    "authors": [
        {
            "name": "Abolfazl Majidi (Afaz)",
            "email": "contact@afaz.me",
            "homepage": "https://afaz.me"
        }
    ],
    "require": {
        "php": ">=8.1",
        "afaztech/reactor-framework": "^0.5.0"
    },
    "autoload": {
        "psr-4": {
            "AfazTech\\ReactorReferral\\": "src/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        },
        "reactor": {
            "providers": [
                "AfazTech\\ReactorReferral\\ReferralServiceProvider"
            ],
            "migrations_namespace": "AfazTech\\ReactorReferral\\Migrations"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
